*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Rider / VS
.idea/
*.sln
*.csproj
*.suo
*.userprefs
*.user
.vs/

# Visual Studio Code
.vscode/

# FMOD
AudioLinkAudioManagerFMOD_*

# Shader cache
ShaderCache/
